# Maintainer: staalmannen <staal1978@gmail.com>
# qtify: https://github.com/staalmannen/qtify
pkgname=motif-on-qt
pkgver=0.1_git202611141549
pkgrel=0
_commit=80f683941783107f408ba88d3aa2f6946d0dbb60
pkgdesc="The Motif, Athena, Xt and Xlib C APIs on Qt 6: build Motif and Xaw programs without X11"
url="https://github.com/staalmannen/motif-on-qt"
arch="all"
license="LGPL-2.1-or-later AND MIT"
depends_dev="qt6-qtbase-dev pkgconf"
makedepends="cmake samurai $depends_dev"
# only a static library: everything is in -dev
subpackages="$pkgname-dev"
source="motif-on-qt-$_commit.tar.gz::https://github.com/staalmannen/motif-on-qt/archive/$_commit.tar.gz"
builddir="$srcdir/motif-on-qt-$_commit"
# the regression tests need the examples, which are not built here
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DMQ_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -rf "$pkgdir"/usr/share/doc
}

dev() {
	# first: default_dev would take the .a file out of the directory
	amove usr/lib/motif-on-qt usr/bin/motif-on-qt-env
	default_dev
}

sha512sums="
c47a32172ebb49309d527c1190e15d5106be3ab65bf1f893e226e80a00aebb02e44fc471d4744ade66e9c76e80a063dcdb497a7c7a629b1d790aee10ce1d6976  motif-on-qt-80f683941783107f408ba88d3aa2f6946d0dbb60.tar.gz
"
