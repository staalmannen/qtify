# Maintainer: staalmannen <https://github.com/staalmannen/qtify>
pkgname=motif-on-qt
pkgver=0.1_git20261113
pkgrel=0
_commit=249a95f10befb10f7c6b6b76587949dbd1abaa16
pkgdesc="The Motif, Xt and Xlib C APIs on Qt 6: build Motif programs without X11 or libXm"
url="https://github.com/staalmannen/qtmotifextension"
arch="all"
license="LGPL-2.1-or-later AND MIT"
depends_dev="qt6-qtbase-dev pkgconf"
makedepends="cmake samurai $depends_dev"
# only a static library: everything is in -dev
subpackages="$pkgname-dev"
source="qtmotifextension-$_commit.tar.gz::https://github.com/staalmannen/qtmotifextension/archive/$_commit.tar.gz"
builddir="$srcdir/qtmotifextension-$_commit"
# the regression tests need the examples, which are not built here
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DMQ_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -rf "$pkgdir"/usr/share/doc
}

dev() {
	default_dev
	amove usr/lib/motif-on-qt usr/bin/motif-on-qt-env
}

sha512sums="
5fa251173ee965a6dbf7b2989da806b833b7e4496b37f9220822ccb58faf0692186a17978b20875b4589e4942ed34e79000fddc0ab925b3f65109738cc655360  qtmotifextension-249a95f10befb10f7c6b6b76587949dbd1abaa16.tar.gz
"
