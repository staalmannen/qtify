# qtify: https://github.com/staalmannen/qtify (aports needs a maintainer line with an e-mail address)
pkgname=motif-on-qt
pkgver=0.1_git20261114
pkgrel=0
_commit=491b66c0cfa740d5ec5a623c66d90f2d3b1e969c
pkgdesc="The Motif, Xt and Xlib C APIs on Qt 6: build Motif programs without X11 or libXm"
url="https://github.com/staalmannen/qtmotifextension"
arch="all"
license="LGPL-2.1-or-later AND MIT"
depends_dev="qt6-qtbase-dev pkgconf"
makedepends="cmake samurai $depends_dev"
# only a static library: everything is in -dev
subpackages="$pkgname-dev"
source="qtmotifextension-$_commit.tar.gz::https://github.com/staalmannen/qtmotifextension/archive/$_commit.tar.gz"
builddir="$srcdir/qtmotifextension-$_commit"
# the regression tests need the examples, which are not built here
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DMQ_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -rf "$pkgdir"/usr/share/doc
}

dev() {
	# first: default_dev would take the .a file out of the directory
	amove usr/lib/motif-on-qt usr/bin/motif-on-qt-env
	default_dev
}

sha512sums="
a153d293c387544cc08957d1de07a089de25392fb9d0a58043e3a0c67ee823fa5ac3d32428c0c22442361cb0ba6db6088698784eb9f4bc04c7fc93850b50e2e8  qtmotifextension-491b66c0cfa740d5ec5a623c66d90f2d3b1e969c.tar.gz
"
