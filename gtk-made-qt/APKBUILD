# Maintainer: staalmannen <https://github.com/staalmannen/qtify>
pkgname=gtk-made-qt
pkgver=0.2.0_git20261113
pkgrel=0
_commit=9d436125e6f070f06036e7a7397f2a8a46d665d9
pkgdesc="The GTK 1.2/2/3/4 C API on Qt 6: build GTK programs that run without GTK"
url="https://github.com/staalmannen/gtk-made-qt"
arch="all"
license="LGPL-2.1-or-later"
# libucontext: musl has no swapcontext (gdk_threads_enter moves GTK calls to the GUI thread with it)
depends_dev="qt6-qtbase-dev glib-dev cairo-dev pango-dev pkgconf libucontext-dev"
makedepends="cmake samurai $depends_dev"
subpackages="$pkgname-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/staalmannen/gtk-made-qt/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"
# the tests need the examples, which are not built here
options="!check"

build() {
	# the static archive must not hold LTO objects
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DGTKQT_BUILD_EXAMPLES=OFF \
		-DGTKQT_BUILD_TESTS=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -rf "$pkgdir"/usr/share/doc
}

dev() {
	default_dev
	# the static library, linker scripts, pkg-config files and gtk-config
	amove usr/lib/gtk-made-qt usr/bin/gtk-made-qt-env
}

sha512sums="
ffde13c28332e2b82cebbf67a2db61b6a65c47b91c1e520db7e2877cdd589fb837d39485e897a6e8afdec629076552d911b5d46b55a2f0c8d9fd388e458612e2  gtk-made-qt-9d436125e6f070f06036e7a7397f2a8a46d665d9.tar.gz
"
