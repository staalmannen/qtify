# Maintainer: staalmannen <https://github.com/staalmannen/qtify>
pkgname=asunder-qtify
pkgver=3.0.1
pkgrel=0
pkgdesc="Asunder, the GTK 2 CD ripper and encoder, built on Qt with GTK made Qt"
url="http://littlesvr.ca/asunder/"
arch="all"
license="GPL-2.0-or-later"
depends="cdparanoia"
makedepends="gtk-made-qt-dev libcddb-dev autoconf automake intltool gettext-dev pkgconf"
checkdepends="cdparanoia"
provides="asunder"
replaces="asunder"
subpackages="$pkgname-lang"
# Debian's copy of the release (+ds: without the generated configure)
source="https://deb.debian.org/debian/pool/main/a/asunder/asunder_$pkgver+ds.orig.tar.xz"
builddir="$srcdir/asunder-$pkgver"

prepare() {
	default_prepare
	intltoolize --force
	autoreconf -fi
}

build() {
	gtk-made-qt-env ./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr
	gtk-made-qt-env make
}

check() {
	mkdir -p "$srcdir"/home/.config
	HOME="$srcdir"/home QT_QPA_PLATFORM=offscreen GTKQT_AUTOQUIT=1500 ./src/asunder
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
a57509358fac68a3c417391f83e1bc8fe7a3d3d33d45cae064769ecf2ad54663a87fcc895af9b5654888db679f7e383545844a1eb45e380483e70ea625771af8  asunder_3.0.1+ds.orig.tar.xz
"
