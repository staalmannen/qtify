#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# debhelper only sets its flags when they are unset; gtk-made-qt-env puts
# its own -L in front of these
export LDFLAGS := $(shell dpkg-buildflags --get LDFLAGS)

%:
	dh $@

# the release's configure is used as it is
override_dh_autoreconf:

DEB_BUILD_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# the shared toolkit: the plugin library calls GTK too. Sylpheed's 2017
# configure rejects options dh_auto_configure adds (--runstatedir)
override_dh_auto_configure:
	# GCC 14 makes libsylph's pointer type mismatches (execute_async) errors
	CFLAGS="$(shell dpkg-buildflags --get CFLAGS) -Wno-error=incompatible-pointer-types" CPPFLAGS="$(shell dpkg-buildflags --get CPPFLAGS)" \
	gtk-made-qt-env --shared ./configure --build=$(DEB_BUILD_GNU_TYPE) --prefix=/usr \
		--mandir=/usr/share/man --sysconfdir=/etc --libdir=/usr/lib/$(DEB_HOST_MULTIARCH) \
		--disable-dependency-tracking --disable-gtkspell --disable-gpgme \
		--disable-compface --disable-rpath

override_dh_auto_build:
	gtk-made-qt-env --shared dh_auto_build

# starts headless in an empty home (the first run dialog) and quits
override_dh_auto_test:
	mkdir -p debian/test-home
	HOME=$(CURDIR)/debian/test-home LANG=C.UTF-8 QT_QPA_PLATFORM=offscreen GTKQT_AUTOQUIT=2000 ./src/sylpheed

override_dh_auto_install:
	dh_auto_install
	find debian/sylpheed-qtify -name '*.la' -exec rm {} +
