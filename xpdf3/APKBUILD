# Maintainer: staalmannen <staal1978@gmail.com>
# qtify: https://github.com/staalmannen/qtify
pkgname=xpdf-qtify
_debver=3.04+git20260802
pkgver=3.04_git20260802
pkgrel=0
pkgdesc="xpdf 3 (the Motif PDF viewer, Poppler based) built on Qt with Motif on Qt"
url="https://tracker.debian.org/pkg/xpdf"
arch="all"
license="GPL-2.0-only OR GPL-3.0-only"
makedepends="motif-on-qt-dev poppler-dev autoconf automake pkgconf"
provides="xpdf"
replaces="xpdf"
subpackages="$pkgname-doc"
source="https://deb.debian.org/debian/pool/main/x/xpdf/xpdf_$_debver.orig.tar.xz"
builddir="$srcdir/xpdf-$_debver"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	# poppler 25 headers use C++20 (std::span, string::ends_with)
	CXXFLAGS="$CXXFLAGS -std=gnu++20" \
	motif-on-qt-env ./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man
	make
}

check() {
	# -v prints the version and exits with status 99 (xpdf's convention)
	QT_QPA_PLATFORM=offscreen ./xpdf/xpdf -v 2>&1 | grep -q 'version 3'
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
8d754c98ea447fe1773b774a91133c337ca17069864c87f00163163a1f9d398c37737b27445bc13078dbfa2fe5c01fc726d417b19db5ea7a19e4549c3591a33f  xpdf_3.04+git20260802.orig.tar.xz
"
